---
import Header from "../components/Header.astro";
import { getTranslator, localeHome, type Locale } from "../i18n/locale";
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	locale?: Locale;
}

const { title, description, locale = "en" } = Astro.props;
const t = getTranslator(locale);
const site = Astro.site ?? Astro.url;
const englishUrl = new URL(localeHome("en"), site);
const portugueseUrl = new URL(localeHome("pt"), site);
const canonicalUrl = locale === "en" ? englishUrl : portugueseUrl;

const socialImage = new URL(
	locale === "en" ? "/social-preview-en.png" : "/social-preview.png",
	Astro.site ?? Astro.url
);
---

<!doctype html>
<html lang={locale === "en" ? "en" : "pt-BR"}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.toString()} />
    <link rel="alternate" hreflang="en" href={englishUrl.toString()} />
    <link rel="alternate" hreflang="pt-BR" href={portugueseUrl.toString()} />
    <link rel="alternate" hreflang="x-default" href={englishUrl.toString()} />
		<meta name="author" content="Klemerson Gomes" />
		<meta name="theme-color" content="#111827" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content={locale === "en" ? "en_US" : "pt_BR"} />
    <meta property="og:locale:alternate" content={locale === "en" ? "pt_BR" : "en_US"} />
    <meta property="og:url" content={canonicalUrl.toString()} />
		<meta property="og:site_name" content={t("Klemerson Gomes | Dados & Analytics", "Klemerson Gomes | Data & Analytics")} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImage.toString()} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content={t("Portfólio profissional de Klemerson Gomes", "Klemerson Gomes professional portfolio")}
		/>

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage.toString()} />
	</head>

	<body>
		<Header locale={locale} />
		<slot />
	</body>
</html>