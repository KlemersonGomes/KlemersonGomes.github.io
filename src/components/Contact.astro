---
import { getTranslator, type Locale } from "../i18n/locale";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const t = getTranslator(locale);
---

<section
	class="portfolio-contact"
	id="contato"
	aria-labelledby="portfolio-contact-title"
>
	<div class="container">
		<div class="portfolio-contact-card">
			<div class="portfolio-contact-content">
				<p class="portfolio-contact-label">{t("Contato", "Contact")}</p>

				<h2 id="portfolio-contact-title">
					{t("Vamos conversar?", "Let's talk")}
				</h2>

				<p class="portfolio-contact-description">
					{t("Se minha experiência em Dados e Analytics fizer sentido para a sua equipe, entre em contato, ficarei feliz em conhecer a oportunidade.", "If my experience in Data and Analytics is a good fit for your team, get in touch. I'd be happy to learn more about the opportunity.")}
				</p>
			</div>

			<div class="portfolio-contact-actions">
				<a
					class="portfolio-linkedin-button"
					href="https://www.linkedin.com/in/klemersongomes/"
					target="_blank"
					rel="noopener noreferrer"
				>
					{t("Conversar no LinkedIn", "Connect on LinkedIn")}
					<span aria-hidden="true">↗</span>
				</a>

				<div class="portfolio-contact-details">
					<div class="portfolio-contact-item">
						<span class="portfolio-contact-item-label">{t("E-mail", "Email")}</span>
						<span class="portfolio-contact-item-value">
							klemersonsg@gmail.com
						</span>
					</div>

					<div class="portfolio-contact-item">
						<span class="portfolio-contact-item-label">{t("Telefone", "Phone")}</span>
						<span class="portfolio-contact-item-value">
							(83) 9 9832-3431
						</span>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.portfolio-contact {
		padding-block: 5rem 6.5rem;
		scroll-margin-top: 72px;
	}

	.portfolio-contact-card {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 290px;
		align-items: center;
		gap: 4rem;
		padding: clamp(2rem, 5vw, 3.5rem);
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		background: var(--color-surface);
	}

	.portfolio-contact-content {
		max-width: 650px;
	}

	.portfolio-contact-label {
		margin: 0 0 1rem;
		color: var(--color-primary);
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.portfolio-contact h2 {
		margin: 0;
		font-size: clamp(2.25rem, 4vw, 3.5rem);
		line-height: 1.1;
		letter-spacing: -0.045em;
	}

	.portfolio-contact-description {
		margin: 1.25rem 0 0;
		color: var(--color-text-muted);
		font-size: 1.05rem;
		line-height: 1.65;
	}

	.portfolio-contact-actions {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.portfolio-linkedin-button {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.65rem;
		min-height: 50px;
		padding: 0.85rem 1.25rem;
		border-radius: 0.6rem;
		background-color: var(--color-primary);
		color: #ffffff;
		font-weight: 700;
		text-align: center;
		text-decoration: none;
		transition:
			filter 150ms ease,
			transform 150ms ease;
	}

	.portfolio-linkedin-button:hover {
		filter: brightness(0.9);
		transform: translateY(-1px);
	}

	.portfolio-linkedin-button:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 4px;
	}

	.portfolio-contact-details {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.portfolio-contact-item {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.portfolio-contact-item-label {
		color: var(--color-text-muted);
		font-size: 0.8rem;
		font-weight: 700;
	}

	.portfolio-contact-item-value {
		color: var(--color-text);
		font-size: 0.95rem;
		font-weight: 600;
		overflow-wrap: anywhere;
		user-select: text;
	}

	@media (max-width: 750px) {
		.portfolio-contact {
			padding-block: 4rem 5rem;
		}

		.portfolio-contact-card {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.portfolio-contact-actions {
			width: 100%;
		}
	}
</style>