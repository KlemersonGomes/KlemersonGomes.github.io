---
import { getTranslator, type Locale } from "../i18n/locale";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const t = getTranslator(locale);
---

<section
	id="qualificacoes"
	class="credentials-section"
	aria-labelledby="credentials-title"
>
	<div class="container">
		<div class="credentials-heading">
            <span class="section-label">{t("Qualificações", "Qualifications")}</span>

            <p id="credentials-title" class="section-description">
                {t("Formação acadêmica, certificações e idiomas que complementam minha atuação em Dados e Analytics.", "Education, certifications, and languages that complement my work in Data and Analytics.")}
            </p>
        </div>

		<div class="credentials-grid">
			<article class="credential-card">
				<div class="credential-accent"></div>

				<span class="credential-label">{t("Formação", "Education")}</span>

				<h3>{t("Bacharelado em Sistemas de Informação", "Bachelor's Degree in Information Systems")}</h3>

				<p>
					Faculdades Integradas de Patos
					<span>2018</span>
				</p>
			</article>

			<article class="credential-card">
				<div class="credential-accent"></div>

				<span class="credential-label">{t("Certificação", "Certification")}</span>

				<h3>Google Data Analytics Professional Certificate</h3>

				<p>
					Coursera
					<span>2024</span>
				</p>
			</article>

			<article class="credential-card">
				<div class="credential-accent"></div>

				<span class="credential-label">{t("Idiomas", "Languages")}</span>

				<h3>{t("Português", "Portuguese")}</h3>

				<p>
					{t("Nativo", "Native")}
				</p>

				<div class="language-secondary">
					<h3>{t("Inglês", "English")}</h3>
					<p>{t("B2 · Intermediário-avançado", "B2 · Upper-intermediate")}</p>
				</div>
			</article>
		</div>
	</div>
</section>

<style>
	.credentials-section {
		padding-block: 4.5rem;
		background: var(--color-background);
		border-bottom: 1px solid var(--color-border);
        scroll-margin-top: 7rem;
	}

	.credentials-heading {
		margin-bottom: 2rem;
		max-width: 620px;
	}

	.section-label {
		display: block;
		margin-bottom: 0.6rem;
		color: var(--color-primary);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

    .section-description {
        margin: 0.65rem 0 0;
        max-width: 680px;
        color: var(--color-text-muted);
        font-size: 1rem;
        line-height: 1.6;
    }

	.credentials-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}

	.credential-card {
		position: relative;
		padding: 2rem;
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		background: var(--color-surface);
		overflow: hidden;
	}

	.credential-accent {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 4px;
		background: var(--color-primary);
	}

	.credential-label {
		display: block;
		margin-bottom: 1rem;
		color: var(--color-primary);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.credential-card h3 {
		margin: 0;
		color: var(--color-text);
		font-size: 1.05rem;
		line-height: 1.45;
	}

	.credential-card p {
		margin: 0.6rem 0 0;
		color: var(--color-text-muted);
		font-size: 0.92rem;
		line-height: 1.55;
	}

	.credential-card p span {
		display: block;
		margin-top: 0.15rem;
	}

	.language-secondary {
		margin-top: 1.35rem;
		padding-top: 1.35rem;
		border-top: 1px solid var(--color-border);
	}

	.language-secondary p {
		margin-top: 0.25rem;
	}

	@media (max-width: 800px) {
		.credentials-section {
			padding-block: 3.5rem;
		}

		.credentials-grid {
			grid-template-columns: 1fr;
		}

		.credential-card {
			padding: 1.6rem;
		}
	}
</style>