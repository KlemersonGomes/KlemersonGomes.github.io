---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "./Hero.astro";
import About from "./About.astro";
import Experience from "./Experience.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import Credentials from "./Credentials.astro";
import { getTranslator, type Locale } from "../i18n/locale";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale);
---

<BaseLayout
  locale={locale}
  title={t("Klemerson Gomes | Dados & Analytics", "Klemerson Gomes | Data & Analytics")}
  description={t("Portfólio profissional de Klemerson Gomes, profissional de Dados e Analytics.", "Professional portfolio of Klemerson Gomes, a Data and Analytics professional.")}
>
  <main>
    <Hero locale={locale} />
    <About locale={locale} />
    <Credentials locale={locale} />
    <Experience locale={locale} />
    <Contact locale={locale} />
    <Footer locale={locale} />
  </main>
</BaseLayout>
