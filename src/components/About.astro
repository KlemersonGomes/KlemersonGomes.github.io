---
import { getTranslator, type Locale } from "../i18n/locale";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const t = getTranslator(locale);
---

<section class="about-section" id="sobre" aria-labelledby="titulo-sobre">
	<div class="container">
		<div class="about-intro">
			<div>
				<p class="section-label">{t("Sobre mim", "About me")}</p>

				<h2 id="titulo-sobre">
					{t("Analytics na interseção entre", "Analytics at the intersection of")}
					<strong>{t("dados, negócio e comunicação.", "data, business, and communication.")}</strong>
				</h2>
			</div>

			<div class="about-copy">
				<p class="lead">
					{t("Sou um profissional de Dados e Analytics com quase sete anos de experiência profissional. Minha atuação tem foco em Analytics e Business Intelligence.", "I am a Data and Analytics professional with nearly seven years of professional experience. My work focuses on Analytics and Business Intelligence.")}
				</p>

				<p>
					{t("Minha atuação parte da compreensão do problema de negócio e avança para a definição de indicadores, análise dos dados, construção de dashboards e comunicação dos resultados.", "I start by understanding the business problem, then define metrics, analyze data, build dashboards, and communicate the findings.")}
				</p>

				<p>
					{t("Tenho maior experiência com Power BI, DAX, Power Query e Excel, ao mesmo tempo em que amplio minha atuação com SQL, Python, Streamlit e IA aplicada a Analytics.", "My strongest experience is with Power BI, DAX, Power Query, and Excel, while I continue to expand my work with SQL, Python, Streamlit, and AI applied to Analytics.")}
				</p>
			</div>
		</div>

		<div class="pillars" aria-label={t("Principais pilares profissionais", "Core professional strengths")}>
			<article>
				<span>01</span>
				<h3>{t("Entendimento de negócio", "Business understanding")}</h3>
				<p>
					{t("Transformação de necessidades pouco estruturadas em perguntas analíticas, indicadores e critérios de decisão.", "Turning loosely defined needs into analytical questions, metrics, and decision criteria.")}
				</p>
			</article>

			<article>
				<span>02</span>
				<h3>{t("Execução analítica", "Analytical delivery")}</h3>
				<p>
					{t("Modelagem, análise, visualização e desenvolvimento de soluções que tornam os dados compreensíveis e utilizáveis.", "Modeling, analysis, visualization, and development of solutions that make data understandable and usable.")}
				</p>
			</article>

			<article>
				<span>03</span>
				<h3>{t("Comunicação", "Communication")}</h3>
				<p>
					{t("Apresentação de resultados com contexto, clareza e foco no que os stakeholders precisam compreender ou decidir.", "Presenting findings with context and clarity, focused on what stakeholders need to understand or decide.")}
				</p>
			</article>
		</div>
	</div>
</section>

<style>
	.about-section {
		padding-block: 6.5rem;
		border-bottom: 1px solid var(--color-border);
		background: var(--color-surface);
		scroll-margin-top: 72px;
	}

	.about-intro {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: clamp(3rem, 8vw, 8rem);
		align-items: start;
	}

	.section-label {
		margin: 0 0 1.25rem;
		color: var(--color-primary);
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	h2 {
		max-width: 650px;
		margin: 0;
		font-size: clamp(2.25rem, 4.5vw, 3.7rem);
		line-height: 1.08;
		letter-spacing: -0.045em;
	}

	h2 strong {
		display: block;
		color: var(--color-primary);
		font-weight: inherit;
	}

	.about-copy {
		padding-top: 2.5rem;
		max-width: 680px;
		color: var(--color-text-muted);
	}

	.about-copy p {
		margin: 0;
		font-size: 1.05rem;
	}

	.about-copy p + p {
		margin-top: 1.25rem;
	}

	.about-copy .lead {
		color: var(--color-text);
		font-size: 1.25rem;
		font-weight: 650;
		line-height: 1.55;
	}

	.pillars {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		margin-top: 4.5rem;
	}

	article {
		padding: 1.75rem;
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		background: var(--color-background);
		transition:
			transform 180ms ease,
			border-color 180ms ease,
			box-shadow 180ms ease;
	}

	article:hover {
		transform: translateY(-4px);
		border-color: rgb(37 99 235 / 35%);
		box-shadow: 0 18px 45px rgb(23 32 51 / 8%);
	}

	article span {
		display: block;
		margin-bottom: 2rem;
		color: var(--color-primary);
		font-size: 0.78rem;
		font-weight: 800;
	}

	h3 {
		margin: 0 0 0.75rem;
		font-size: 1.1rem;
		letter-spacing: -0.02em;
	}

	article p {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	@media (max-width: 800px) {
		.about-section {
			padding-block: 5rem;
		}

		.about-intro {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.about-copy {
			padding-top: 0;
		}

		.pillars {
			grid-template-columns: 1fr;
			margin-top: 3.5rem;
		}

		article span {
			margin-bottom: 1rem;
		}
	}
</style>