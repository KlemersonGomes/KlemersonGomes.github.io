        font-weight: 600;

    }



    .experience-details {

        margin-top: 1.75rem;

        border-top: 1px solid var(--color-border);

    }



    .details-toggle {

        display: flex;

        align-items: center;

        gap: 0.75rem;

        padding-top: 1.25rem;

        color: var(--color-text);

        font-weight: 700;

        cursor: pointer;

        list-style: none;

        user-select: none;

    }



    .details-toggle::-webkit-details-marker {

        display: none;

    }



    .details-toggle:hover {

        color: var(--color-primary);

    }



    .details-toggle:focus-visible {

        border-radius: 0.35rem;

        outline: 2px solid var(--color-primary);

        outline-offset: 4px;

    }



    .toggle-icon {

        position: relative;

        flex: 0 0 24px;

        width: 24px;

        height: 24px;

        border: 1px solid var(--color-border);

        border-radius: 50%;

        background: var(--color-background);

    }



    .toggle-icon::before,

    .toggle-icon::after {

        position: absolute;

        top: 50%;

        left: 50%;

        width: 10px;

        height: 2px;

        border-radius: 999px;

        background: var(--color-primary);

        content: "";

        transform: translate(-50%, -50%);

    }



    .toggle-icon::after {

        transform: translate(-50%, -50%) rotate(90deg);

        transition: opacity 0.2s ease;

    }



    .experience-details[open] .toggle-icon::after {

        opacity: 0;

    }



    .details-content {

        margin-top: 1.25rem;

        padding: 1.5rem;

        border: 1px solid var(--color-border);

        border-radius: 0.75rem;

        background: var(--color-background);

    }



    .details-section + .details-section {

        margin-top: 1.75rem;

        padding-top: 1.75rem;

        border-top: 1px solid var(--color-border);

    }



    .details-label {

        margin: 0 0 0.85rem;

        color: var(--color-primary);

        font-size: 0.78rem;

        font-weight: 800;

        letter-spacing: 0.1em;

        text-transform: uppercase;

    }



    .details-section ul {

        display: grid;

        gap: 0.65rem;

        margin: 0;

        padding-left: 1.25rem;

        color: var(--color-text-muted);

    }



    .projects-list {

        display: grid;

        gap: 1.25rem;

    }



    .project-item h4 {

        margin: 0;

        color: var(--color-text);

        font-size: 1rem;

        line-height: 1.4;

    }



    .project-item p {

        margin: 0.4rem 0 0;

        color: var(--color-text-muted);

        line-height: 1.6;

    }



    .details-empty {

        margin: 0;

        color: var(--color-text-muted);

        font-size: 0.95rem;

    }



    @media (max-width: 650px) {

        .experience {

            padding-block: 5rem;

        }



        .experience-card {

            padding: 1.5rem;

        }



        .role-heading {

            flex-direction: column;

            gap: 0.4rem;

        }



        .details-content {

            padding: 1.25rem;

        }

    }

</style>
