<section class="experience" id="experiencia" aria-labelledby="experience-title">

    <div class="container">

        <div class="section-heading">

            <p class="section-label">Trajetória</p>



            <h2 id="experience-title">Experiência profissional</h2>



            <p>

                Soluções analíticas desenvolvidas em diferentes contextos de negócio,

                da definição dos indicadores à comunicação dos resultados.

            </p>

        </div>



        <div class="timeline">

            {

                experiences.map((experience) => (

                    <article class="experience-card">

                        <div class="role-heading">

                            <div class="company-heading">

                                <a

                                    class="company-link"

                                    href={experience.linkedin}

                                    target="_blank"

                                    rel="noopener noreferrer"

                                    aria-label={`Ver ${experience.company} no LinkedIn (abre em nova aba)`}

                                >

                                    <span class="company-logo">

                                        <img

                                            src={experience.logo}

                                            alt=""

                                            width="40"

                                            height="40"

                                            loading="lazy"

                                        />



                                        <span class="logo-fallback" aria-hidden="true">

                                            {experience.logoFallback}

                                        </span>

                                    </span>



                                    <div class="company-copy">

                                        <h3>{experience.role}</h3>

                                        <span class="company">{experience.company}</span>

                                    </div>

                                </a>

                            </div>



                            <p class="period">{experience.period}</p>

                        </div>



                        <p class="context">{experience.context}</p>



                        <ul class="contributions">

                            {experience.contributions.map((item) => <li>{item}</li>)}

                        </ul>



                        <ul class="technologies" aria-label="Tecnologias utilizadas">

                            {experience.technologies.map((item) => <li>{item}</li>)}

                        </ul>



                        <details class="experience-details">

                            <summary class="details-toggle">

                                <span class="toggle-icon" aria-hidden="true"></span>

                                <span>Projetos e desafios</span>

                            </summary>



                            <div class="details-content">

                                {

                                    experience.details.challenges.length > 0 && (

                                        <div class="details-section">

                                            <p class="details-label">Principais desafios</p>



                                            <ul>

                                                {experience.details.challenges.map((item) => (

                                                    <li>{item}</li>

                                                ))}

                                            </ul>

                                        </div>

                                    )

                                }



                                {

                                    experience.details.projects.length > 0 && (

                                        <div class="details-section">

                                            <p class="details-label">Projetos relevantes</p>



                                            <div class="projects-list">

                                                {experience.details.projects.map((project) => (

                                                    <div class="project-item">

                                                        <h4>{project.title}</h4>

                                                        <p>{project.description}</p>

                                                    </div>

                                                ))}

                                            </div>

                                        </div>

                                    )

                                }



                                {

                                    experience.details.impact?.length > 0 && (

                                        <div class="details-section">

                                            <p class="details-label">Impacto</p>



                                            <ul>

                                                {experience.details.impact.map((item) => (

                                                    <li>{item}</li>

                                                ))}

                                            </ul>

                                        </div>

                                    )

                                }



                                {

                                    experience.details.challenges.length === 0 &&

                                        experience.details.projects.length === 0 &&

                                        !experience.details.impact?.length && (

                                            <p class="details-empty">

                                                Os detalhes desta experiência serão adicionados nesta

                                                área.

                                            </p>

                                        )

                                }

                            </div>

                        </details>

                    </article>

                ))

            }

        </div>

    </div>

</section>



<script>

    document

        .querySelectorAll<HTMLImageElement>(".company-logo img")

        .forEach((image) => {

            const showFallback = () => image.classList.add("is-unavailable");



            image.addEventListener("error", showFallback);



            if (image.complete && image.naturalWidth === 0) showFallback();

        });

</script>



<style>

    .experience {

        padding-block: 6.5rem;

        scroll-margin-top: 72px;

    }



    .section-heading {

        max-width: 740px;

        margin-bottom: 3rem;

    }



    .section-label {

        margin: 0 0 1rem;

        color: var(--color-primary);

        font-size: 0.8rem;

        font-weight: 800;

        letter-spacing: 0.12em;

        text-transform: uppercase;

    }



