---
import { getTranslator, type Locale } from "../i18n/locale";
import { experiencesByLocale } from "../i18n/experiences";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const t = getTranslator(locale);

const experiences = experiencesByLocale[locale];
---

<section class="experience" id="experiencia" aria-labelledby="experience-title">
	<div class="container">
		<div class="section-heading">
			<p class="section-label">{t("Trajetória", "Career")}</p>

			<h2 id="experience-title">{t("Experiência profissional", "Professional experience")}</h2>

			<p>
				{t("Soluções analíticas desenvolvidas em diferentes contextos de negócio, da definição dos indicadores à comunicação dos resultados.", "Analytical solutions developed across different business contexts, from defining metrics to communicating findings.")}
			</p>
		</div>

		<div class="timeline">
			{
				experiences.map((experience) => (
					<article class="experience-card">
						<div class="role-heading">
							<div class="company-heading">
								<a
									class="company-link"
									href={experience.linkedin}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={t(`Ver ${experience.company} no LinkedIn (abre em nova aba)`, `View ${experience.company} on LinkedIn (opens in a new tab)`)}
								>
									<span class="company-logo">
										<img
											src={experience.logo}
											alt=""
											width="40"
											height="40"
											loading="lazy"
										/>

										<span class="logo-fallback" aria-hidden="true">
											{experience.logoFallback}
										</span>
									</span>

									<div class="company-copy">
										<h3>{experience.role}</h3>
										<span class="company">{experience.company}</span>
									</div>
								</a>
							</div>

							<p class="period">{experience.period}</p>
						</div>

						<p class="context">{experience.context}</p>

						<ul class="contributions">
							{experience.contributions.map((item) => <li>{item}</li>)}
						</ul>

						<ul class="technologies" aria-label={t("Tecnologias utilizadas", "Technologies used")}>
							{experience.technologies.map((item) => <li>{item}</li>)}
						</ul>

						<details class="experience-details">
							<summary class="details-toggle">
								<span class="toggle-icon" aria-hidden="true"></span>
								<span>{t("Projetos e desafios", "Projects and challenges")}</span>
							</summary>

							<div class="details-content">
								{
									experience.details.keyChallenges?.length > 0 && (
										<div class="details-section">
											<p class="details-label">{t("Desafios-chave", "Key challenges")}</p>

											<ul>
												{experience.details.keyChallenges.map((item) => (
													<li>{item}</li>
												))}
											</ul>
										</div>
									)
								}

								{
									experience.details.challenges.length > 0 && (
										<div class="details-section">
											<p class="details-label">{t("Principais desafios", "Challenges in detail")}</p>

											<ul>
												{experience.details.challenges.map((item) => (
													<li>{item}</li>
												))}
											</ul>
										</div>
									)
								}

								{
									experience.details.projects.length > 0 && (
										<div class="details-section">
											<p class="details-label">{t("Projetos relevantes", "Selected projects")}</p>

											<div class="projects-list">
												{experience.details.projects.map((project) => (
													<div class="project-item">
														<h4>{project.title}</h4>
														<p>{project.description}</p>
													</div>
												))}
											</div>
										</div>
									)
								}

								{
									experience.details.impact?.length > 0 && (
										<div class="details-section">
											<p class="details-label">{t("Impacto", "Impact")}</p>

											<ul>
												{experience.details.impact.map((item) => (
													<li>{item}</li>
												))}
											</ul>
										</div>
									)
								}

								{
									!experience.details.keyChallenges?.length &&
										experience.details.challenges.length === 0 &&
										experience.details.projects.length === 0 &&
										!experience.details.impact?.length && (
											<p class="details-empty">
												{t("Os detalhes desta experiência serão adicionados nesta área.", "Details of this experience will be added here.")}
											</p>
										)
								}
							</div>
						</details>
					</article>
				))
			}
		</div>
	</div>
</section>

<script>
	document
		.querySelectorAll<HTMLImageElement>(".company-logo img")
		.forEach((image) => {
			const showFallback = () => image.classList.add("is-unavailable");

			image.addEventListener("error", showFallback);

			if (image.complete && image.naturalWidth === 0) showFallback();
		});
</script>

<style>
	.experience {
		padding-block: 6.5rem;
		scroll-margin-top: 72px;
	}

	.section-heading {
		max-width: 740px;
		margin-bottom: 3rem;
	}

	.section-label {
		margin: 0 0 1rem;
		color: var(--color-primary);
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	h2 {
		margin: 0;
		font-size: clamp(2.25rem, 4vw, 3.5rem);
		line-height: 1.1;
		letter-spacing: -0.045em;
	}

	.section-heading > p:last-child {
		color: var(--color-text-muted);
		font-size: 1.05rem;
	}

	.timeline {
		display: grid;
		gap: 1.25rem;
		padding-left: 1.5rem;
		border-left: 2px solid var(--color-border);
	}

	.experience-card {
		position: relative;
		padding: 2rem;
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		background: var(--color-surface);
	}

	.experience-card::before {
		position: absolute;
		top: 2.4rem;
		left: calc(-1.5rem - 7px);
		width: 12px;
		height: 12px;
		border: 3px solid var(--color-background);
		border-radius: 50%;
		background: var(--color-primary);
		content: "";
	}

	.role-heading {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}

	.company-heading {
		min-width: 0;
	}

	.company-link {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		min-width: 0;
		color: inherit;
		text-decoration: none;
	}

	.company-copy {
		display: grid;
		gap: 0.2rem;
	}

	.company-logo {
		position: relative;
		display: grid;
		flex: 0 0 52px;
		place-items: center;
		width: 52px;
		height: 52px;
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
		background: #fff;
	}

	.company-link:hover .company-logo,
	.company-link:focus-visible .company-logo {
		border-color: var(--color-primary);
	}

	.company-link:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 3px;
	}

	.company-link:hover .company {
		text-decoration: underline;
	}

	.company-logo img {
		position: absolute;
		width: 40px;
		height: 40px;
		background: #fff;
		object-fit: contain;
	}

	.logo-fallback {
		display: none;
		color: #3b3455;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: -0.02em;
	}

	.company-logo img.is-unavailable {
		display: none;
	}

	.company-logo img.is-unavailable + .logo-fallback {
		display: block;
	}

	h3 {
		margin: 0;
		font-size: 1.35rem;
		letter-spacing: -0.025em;
	}

	.company {
		color: var(--color-primary);
		font-weight: 700;
	}

	.period {
		margin: 0;
		color: var(--color-text-muted);
		white-space: nowrap;
	}

	.context {
		margin: 1.5rem 0 0;
	}

	.contributions {
		display: grid;
		gap: 0.6rem;
		margin: 1rem 0 0;
		padding-left: 1.25rem;
		color: var(--color-text-muted);
	}

	.technologies {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.technologies li {
		padding: 0.3rem 0.65rem;
		border: 1px solid var(--color-border);
		border-radius: 0.4rem;
		background: var(--color-background);
		font-size: 0.8rem;
		font-weight: 600;
	}

	.experience-details {
		margin-top: 1.75rem;
		border-top: 1px solid var(--color-border);
	}

	.details-toggle {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding-top: 1.25rem;
		color: var(--color-text);
		font-weight: 700;
		cursor: pointer;
		list-style: none;
		user-select: none;
	}

	.details-toggle::-webkit-details-marker {
		display: none;
	}

	.details-toggle:hover {
		color: var(--color-primary);
	}

	.details-toggle:focus-visible {
		border-radius: 0.35rem;
		outline: 2px solid var(--color-primary);
		outline-offset: 4px;
	}

	.toggle-icon {
		position: relative;
		flex: 0 0 24px;
		width: 24px;
		height: 24px;
		border: 1px solid var(--color-border);
		border-radius: 50%;
		background: var(--color-background);
	}

	.toggle-icon::before,
	.toggle-icon::after {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 10px;
		height: 2px;
		border-radius: 999px;
		background: var(--color-primary);
		content: "";
		transform: translate(-50%, -50%);
	}

	.toggle-icon::after {
		transform: translate(-50%, -50%) rotate(90deg);
		transition: opacity 0.2s ease;
	}

	.experience-details[open] .toggle-icon::after {
		opacity: 0;
	}

	.details-content {
		margin-top: 1.25rem;
		padding: 1.5rem;
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
		background: var(--color-background);
	}

	.details-section + .details-section {
		margin-top: 1.75rem;
		padding-top: 1.75rem;
		border-top: 1px solid var(--color-border);
	}

	.details-label {
		margin: 0 0 0.85rem;
		color: var(--color-primary);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.details-section ul {
		display: grid;
		gap: 0.65rem;
		margin: 0;
		padding-left: 1.25rem;
		color: var(--color-text-muted);
	}

	.projects-list {
		display: grid;
		gap: 1.25rem;
	}

	.project-item h4 {
		margin: 0;
		color: var(--color-text);
		font-size: 1rem;
		line-height: 1.4;
	}

	.project-item p {
		margin: 0.4rem 0 0;
		color: var(--color-text-muted);
		line-height: 1.6;
	}

	.details-empty {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.95rem;
	}

	@media (max-width: 650px) {
		.experience {
			padding-block: 5rem;
		}

		.experience-card {
			padding: 1.5rem;
		}

		.role-heading {
			flex-direction: column;
			gap: 0.4rem;
		}

		.details-content {
			padding: 1.25rem;
		}
	}
</style>