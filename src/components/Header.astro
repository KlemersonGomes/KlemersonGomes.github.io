---
import { getTranslator, localeHome, type Locale } from "../i18n/locale";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const t = getTranslator(locale);
---

<header class="site-header">
  <div class="container header-content">
    <a class="brand" href={localeHome(locale)} aria-label={t("Página inicial", "Home page")}>
      Klemerson <span>Gomes</span>
    </a>

    <nav aria-label={t("Navegação principal", "Main navigation")}>
      <a href="#sobre">{t("Sobre", "About")}</a>
      <a href="#qualificacoes">{t("Qualificações", "Qualifications")}</a>
      <a href="#experiencia">{t("Experiência", "Experience")}</a>
      <a href="#contato">{t("Contato", "Contact")}</a>
    </nav>

    <div class="language-switch" role="group" aria-label={t("Idioma", "Language")}>
      <a href="/" data-language-link="/" lang="en" hreflang="en" title="English"
        aria-label={t("Ler em inglês", "Read in English")}
        aria-current={locale === "en" ? "page" : undefined}>
        <span class="language-name">English</span><span class="language-code" aria-hidden="true">EN</span>
      </a>
      <a href="/pt/" data-language-link="/pt/" lang="pt-BR" hreflang="pt-BR" title="Português"
        aria-label={t("Ler em português", "Read in Portuguese")}
        aria-current={locale === "pt" ? "page" : undefined}>
        <span class="language-name">Português</span><span class="language-code" aria-hidden="true">PT</span>
      </a>
    </div>
  </div>
</header>

<script>
  function syncLanguageLinks() {
    document.querySelectorAll<HTMLAnchorElement>("[data-language-link]").forEach((link) => {
      const base = link.dataset.languageLink;
      if (base) link.href = base + window.location.hash;
    });
  }

  syncLanguageLinks();
  window.addEventListener("hashchange", syncLanguageLinks);
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		border-bottom: 1px solid var(--color-border);
		background: rgb(247 249 252 / 90%);
		backdrop-filter: blur(12px);
	}

	.header-content {
		display: grid;
		grid-template-columns: auto 1fr auto;
		min-height: 72px;
		align-items: center;
		gap: 2rem;
	}

	.brand {
		font-size: 1.05rem;
		font-weight: 750;
		letter-spacing: -0.02em;
	}

	.brand span {
		color: var(--color-primary);
	}

	nav {
		justify-self: end;
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	nav a {
		color: var(--color-text-muted);
		font-size: 0.95rem;
		font-weight: 600;
		transition: color 160ms ease;
	}

	nav a:hover,
	nav a:focus-visible {
		color: var(--color-primary);
	}

	@media (max-width: 850px) {
		.header-content {
			min-height: auto;
			padding-block: 1rem;
			grid-template-columns: 1fr auto;
			gap: 0.75rem;
		}

		nav {
			grid-column: 1 / -1;
			grid-row: 2;
			flex-wrap: wrap;
			width: 100%;
			justify-content: space-between;
			gap: 0.75rem;
		}
	}

  .language-switch {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    padding: 0.2rem;
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    white-space: nowrap;
  }

  .language-switch a {
    padding: 0.3rem 0.6rem;
    border-radius: 0.4rem;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .language-switch a[aria-current="page"] {
    background: var(--color-primary);
    color: #fff;
  }

  .language-switch a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .language-code {
    display: none;
  }

  @media (max-width: 600px) {
    .language-name {
      display: none;
    }

    .language-code {
      display: inline;
    }
  }
</style>